# ==========================================
# DocuFlow AI Frontend Environment Variables
# ==========================================

# Public Production Backend API URL (e.g. https://docuflow-api.onrender.com/api/v1 or http://localhost:5000/api/v1)
VITE_API_URL=https://YOUR_BACKEND_URL.onrender.com/api/v1

# Application Name
VITE_APP_NAME="DocuFlow AI"

# Optional Google OAuth Client ID for Web Sign-In
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional Frontend Gemini API Key
VITE_GEMINI_API_KEY=
