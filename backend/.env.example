# =========================================
# DocuFlow AI Backend Environment Variables
# =========================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String (Atlas or Hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/docuflow?retryWrites=true&w=majority

# JWT Security Secrets (Must be random, secure strings in production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Hosting URL & Allowed CORS Origins (Comma-separated for multiple domains)
FRONTEND_URL=https://your-docuflow-app.netlify.app
CORS_ORIGINS=https://your-docuflow-app.netlify.app,http://localhost:5173

# OTP Configuration
OTP_EXPIRES_MINUTES=10

# Gmail SMTP / Nodemailer Email Dispatch Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
EMAIL_FROM="DocuFlow AI <noreply@docuflow.ai>"

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Providers (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloud Storage (Optional Cloudinary / AWS S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=docuflow-storage

# Razorpay Payments (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
